# Copy to .env and adjust. Every value has a sensible default.

SITE_NAME=CodeArena
PORT=3000
HOST=0.0.0.0
# NODE_ENV=production        # enables secure cookies + static caching

# First-boot admin account (created only if no admin exists yet).
ADMIN_HANDLE=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Storage
DATA_DIR=data                # SQLite DB + test data live here

# Sessions / proxy
SESSION_TTL_DAYS=30
# SECURE_COOKIE=true         # set when served over HTTPS
# TRUST_PROXY=true           # set behind nginx / a load balancer

# Judge
JUDGE_EMBEDDED=true          # false = run `npm run judge` as separate worker process(es)
JUDGE_WORKERS=3
# SANDBOX_PYTHON=python3     # interpreter for the sandbox supervisor (python on Windows)
# SANDBOX_UID=20000          # Linux: base uid; worker i runs submissions as SANDBOX_UID+i (supervisor must be root; Docker image default)
# SANDBOX_GID=65534
COMPILE_TIMEOUT_MS=30000
OUTPUT_LIMIT_MB=64
MAX_SOURCE_BYTES=65536
SUBMIT_COOLDOWN_MS=5000
JUDGE_STOP_ON_FIRST_FAILURE=true

# First boot (the Docker image turns these on; locally use `npm run seed` / `npm run import`)
# AUTO_SEED=true             # build the built-in problem set when the database is empty
# AUTO_IMPORT_ARCHIVE=true   # import the multi-judge archive when it is empty

# Archive importers
ARCHIVE_AUTO_SYNC_HOURS=0    # e.g. 24 to refresh Codeforces/AtCoder/UVa/CSES daily
